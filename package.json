{
  "name": "openworld",
  "version": "1.0.0",
  "description": "The real Earth, abstracted: a walking game built from open data.",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:beta": "vite build --mode beta --outDir dist/beta",
    "build:app": "node scripts/build-www.mjs",
    "ios:sync": "npm run build:app && npx cap sync ios"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@mapbox/vector-tile": "^3.0.0",
    "earcut": "^3.2.4",
    "pbf": "^5.1.2",
    "suncalc": "^2.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
